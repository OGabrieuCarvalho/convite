<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Um convite especial 🌹</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Lato:wght@300;400&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --rosa: #c0476b;
      --rosa-escuro: #a33a59;
      --rosa-claro: #f5e6ec;
      --amber-claro: #fdf3e7;
      --texto: #1a1a1a;
      --texto-sec: #6b6b6b;
      --borda: rgba(0,0,0,0.12);
    }

    html, body {
      min-height: 100%;
      width: 100%;
      overflow-x: hidden;
    }

    body {
      background: #fff9f6;
      font-family: 'Lato', sans-serif;
      color: var(--texto);
    }

    #confete-wrap {
      position: fixed;
      top: 0; left: 0;
      width: 100%; height: 100%;
      pointer-events: none;
      z-index: 999;
      overflow: hidden;
    }

    .confete-p {
      position: absolute;
      top: -20px;
      animation: cair linear forwards;
    }

    @keyframes cair {
      0%   { transform: translateY(0) rotate(0deg); opacity: 1; }
      80%  { opacity: 1; }
      100% { transform: translateY(110vh) rotate(720deg); opacity: 0; }
    }

    #tela {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: clamp(2rem, 8vw, 5rem) clamp(1.2rem, 6vw, 3rem);
      text-align: center;
      position: relative;
    }

    .petal-bg {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
      z-index: 0;
    }

    .petal {
      position: absolute;
      font-size: clamp(1rem, 3vw, 1.6rem);
      opacity: 0.18;
      animation: flutuar linear infinite;
    }

    @keyframes flutuar {
      0%   { transform: translateY(0) rotate(0deg); }
      100% { transform: translateY(-110vh) rotate(360deg); }
    }

    .conteudo {
      position: relative;
      z-index: 1;
      max-width: 560px;
      width: 100%;
    }

    .roses {
      font-size: clamp(1.8rem, 6vw, 2.6rem);
      margin-bottom: 1.5rem;
      animation: aparecer 0.8s ease both;
    }

    @keyframes aparecer {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .data-badge {
      display: inline-block;
      font-family: 'Lato', sans-serif;
      font-weight: 300;
      font-size: clamp(0.75rem, 2.2vw, 0.85rem);
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--rosa);
      border: 1px solid var(--rosa);
      border-radius: 40px;
      padding: 0.3rem 1.2rem;
      margin-bottom: 1.4rem;
      animation: aparecer 0.8s 0.05s ease both;
      opacity: 0.85;
    }

    h1 {
      font-family: 'Playfair Display', serif;
      font-size: clamp(1.7rem, 5.5vw, 2.8rem);
      font-weight: 400;
      color: var(--texto);
      margin-bottom: 0.6rem;
      line-height: 1.2;
      animation: aparecer 0.9s 0.1s ease both;
    }

    h1 em {
      font-style: italic;
      color: var(--rosa);
    }

    .sub {
      font-weight: 300;
      font-size: clamp(0.9rem, 2.8vw, 1.05rem);
      color: var(--texto-sec);
      margin-bottom: 2.8rem;
      letter-spacing: 0.04em;
      animation: aparecer 1s 0.2s ease both;
    }

    .pergunta {
      font-family: 'Playfair Display', serif;
      font-size: clamp(1.15rem, 3.5vw, 1.5rem);
      color: var(--texto);
      margin-bottom: 2rem;
      animation: aparecer 1s 0.3s ease both;
    }

    .botoes-row {
      display: flex;
      gap: 1rem;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      animation: aparecer 1s 0.4s ease both;
    }

    #btn-sim,
    #btn-nao {
      font-family: 'Lato', sans-serif;
      font-size: clamp(0.9rem, 3vw, 1rem);
      letter-spacing: 0.08em;
      padding: 0.8rem 2.4rem;
      background: var(--rosa);
      color: #fff;
      border: none;
      border-radius: 40px;
      cursor: pointer;
      white-space: nowrap;
      transition: background 0.2s, transform 0.1s, top 0.2s ease, left 0.2s ease;
    }

    #btn-sim:hover { background: var(--rosa-escuro); transform: scale(1.04); }
    #btn-sim:active { transform: scale(0.97); }

    #btn-nao:hover  { background: var(--rosa-escuro); }
    #btn-nao:active { transform: scale(0.97); }

    #btn-nao.fugindo {
      position: fixed;
      z-index: 100;
    }

    #roteiro {
      display: none;
      min-height: 100vh;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: clamp(2rem, 8vw, 5rem) clamp(1.2rem, 6vw, 3rem);
      text-align: center;
    }

    .check-circle {
      width: 60px; height: 60px;
      border-radius: 50%;
      background: var(--rosa);
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 1.4rem;
      animation: aparecer 0.6s ease both;
    }

    .check-circle svg { width: 30px; height: 30px; }

    .rot-titulo {
      font-family: 'Playfair Display', serif;
      font-size: clamp(1.6rem, 5vw, 2.2rem);
      font-weight: 400;
      color: var(--texto);
      margin-bottom: 0.4rem;
      animation: aparecer 0.7s 0.1s ease both;
    }

    .rot-sub {
      font-weight: 300;
      color: var(--texto-sec);
      font-size: clamp(0.88rem, 2.8vw, 1rem);
      margin-bottom: 3rem;
      letter-spacing: 0.04em;
      animation: aparecer 0.8s 0.2s ease both;
    }

    .timeline {
      display: flex;
      flex-direction: column;
      width: 100%;
      max-width: 400px;
      animation: aparecer 0.9s 0.3s ease both;
    }

    .evento {
      display: flex;
      align-items: flex-start;
      gap: 1.1rem;
      text-align: left;
      padding-bottom: 2.2rem;
    }

    .evento:last-child { padding-bottom: 0; }

    .icone-wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      flex-shrink: 0;
    }

    .icone {
      width: 48px; height: 48px;
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.4rem;
      flex-shrink: 0;
    }

    .icone-missa  { background: var(--rosa-claro); }
    .icone-jantar { background: var(--amber-claro); }

    .linha-v {
      width: 1px; flex: 1;
      background: var(--borda);
      margin-top: 6px; min-height: 36px;
    }

    .ev-info { padding-top: 8px; }

    .ev-hora {
      font-size: 0.75rem;
      color: var(--rosa);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin-bottom: 3px;
    }

    .ev-nome {
      font-family: 'Playfair Display', serif;
      font-size: clamp(1.05rem, 3.5vw, 1.2rem);
      color: var(--texto);
      margin-bottom: 3px;
    }

    .ev-desc {
      font-weight: 300;
      font-size: clamp(0.84rem, 2.5vw, 0.9rem);
      color: var(--texto-sec);
    }

    .divisor {
      width: 40px;
      height: 1px;
      background: var(--rosa);
      margin: 0 auto 1.8rem;
      opacity: 0.4;
    }
  </style>
</head>
<body>

<div id="confete-wrap"></div>
<button id="btn-nao">Não</button>

<div id="tela">
  <div class="petal-bg" id="petals"></div>

  <div class="conteudo">
    <div class="roses">🌹🌹🌹</div>
    <h1>Jéssica, você toparia um<br><em>encontro especial</em> comigo?</h1>
    <p class="sub">tenho algo muito especial planejado para nós dois</p>
    <div class="divisor"></div>
    <p class="pergunta">O que você acha?</p>
    <div class="botoes-row">
      <button id="btn-sim" onclick="aceitar()">Sim, adoraria!</button>
    </div>
  </div>
</div>

<div id="roteiro">
  <div class="check-circle">
    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="20 6 9 17 4 12"/>
    </svg>
  </div>
  <h2 class="rot-titulo">Que bom!</h2>
  <div class="data-badge" style="margin-bottom:0.8rem;">06 de junho de 2026</div>
  <p class="rot-sub">Aqui está o nosso roteiro para a noite</p>

  <div class="timeline">
    <div class="evento">
      <div class="icone-wrap">
        <div class="icone icone-missa">⛪</div>
        <div class="linha-v"></div>
      </div>
      <div class="ev-info">
        <p class="ev-hora">19:00</p>
        <p class="ev-nome">Missa</p>
        <p class="ev-desc">Catedral Santo Antônio</p>
      </div>
    </div>

    <div class="evento">
      <div class="icone-wrap">
        <div class="icone icone-jantar">🍝</div>
      </div>
      <div class="ev-info">
        <p class="ev-hora">Após a missa</p>
        <p class="ev-nome">Jantar italiano</p>
        <p class="ev-desc">Uma noite deliciosa com culinária italiana, vinho e boa conversa</p>
      </div>
    </div>
  </div>
</div>

<script>
  const nao = document.getElementById('btn-nao');
  const botoeRow = document.querySelector('.botoes-row');
  let fugindo = false;
  let intervalo = null;

  botoeRow.appendChild(nao);

  function ativarFuga() {
    if (fugindo) return;
    fugindo = true;

    const rect = nao.getBoundingClientRect();
    nao.style.left = rect.left + 'px';
    nao.style.top = rect.top + 'px';
    nao.classList.add('fugindo');

    moverNao();
    intervalo = setInterval(moverNao, 1200);
  }

  function moverNao() {
    const bw = nao.offsetWidth;
    const bh = nao.offsetHeight;
    const maxX = window.innerWidth - bw - 8;
    const maxY = window.innerHeight - bh - 8;
    nao.style.left = (8 + Math.random() * maxX) + 'px';
    nao.style.top  = (8 + Math.random() * maxY) + 'px';
  }

  nao.addEventListener('mouseover', ativarFuga);
  nao.addEventListener('touchstart', ativarFuga, { passive: true });
  nao.addEventListener('click', () => { ativarFuga(); moverNao(); });

  function aceitar() {
    if (intervalo) clearInterval(intervalo);
    nao.style.display = 'none';
    document.getElementById('tela').style.display = 'none';
    document.getElementById('roteiro').style.display = 'flex';
    lancarConfetes();
  }

  function lancarConfetes() {
    const wrap = document.getElementById('confete-wrap');
    const cores = ['#c0476b','#e8a0b4','#f9d6e2','#d4af37','#f5e6b0','#a8d8a8','#7ec8e3','#fff'];
    for (let i = 0; i < 160; i++) {
      const p = document.createElement('div');
      p.className = 'confete-p';
      p.style.left = (Math.random() * 100) + '%';
      p.style.top  = (-20 - Math.random() * 150) + 'px';
      p.style.background = cores[Math.floor(Math.random() * cores.length)];
      p.style.width  = (6 + Math.random() * 9) + 'px';
      p.style.height = (3 + Math.random() * 6) + 'px';
      p.style.borderRadius = Math.random() > 0.5 ? '50%' : '2px';
      p.style.animationDuration = (1.8 + Math.random() * 2.5) + 's';
      p.style.animationDelay   = (Math.random() * 1) + 's';
      wrap.appendChild(p);
      setTimeout(() => p.remove(), 5000);
    }
  }

  const petals = document.getElementById('petals');
  const emojis = ['🌸', '🌹', '✨', '🌷'];
  for (let i = 0; i < 14; i++) {
    const p = document.createElement('div');
    p.className = 'petal';
    p.textContent = emojis[Math.floor(Math.random() * emojis.length)];
    p.style.left = (Math.random() * 100) + '%';
    p.style.bottom = (-10 - Math.random() * 20) + '%';
    p.style.animationDuration = (12 + Math.random() * 16) + 's';
    p.style.animationDelay = (-Math.random() * 16) + 's';
    petals.appendChild(p);
  }
</script>

</body>
</html>
